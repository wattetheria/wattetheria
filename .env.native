# Native (no Docker) deployment: wattetheria + wattswarm on SQLite.
#
# The npm CLI supervises the native binaries directly. Every service binds to
# loopback except the Wattswarm P2P ports.
WATTETHERIA_DEPLOYMENT_RUNTIME=native

# Host bindings
WATTETHERIA_CONTROL_PLANE_BIND_HOST=127.0.0.1
WATTETHERIA_CONTROL_PLANE_PORT=7777
WATTSWARM_UI_BIND_HOST=127.0.0.1
WATTSWARM_UI_PORT=7788
WATTSWARM_SYNC_GRPC_BIND_HOST=127.0.0.1
WATTSWARM_SYNC_GRPC_PORT=7791
WATTSWARM_RUNTIME_BIND_HOST=127.0.0.1
WATTSWARM_RUNTIME_PORT=8787

# State directories, relative to the deployment directory
WATTETHERIA_HOST_STATE_DIR=./data/wattetheria
WATTSWARM_HOST_STATE_DIR=./data/wattswarm

# Agent-facing endpoints written into .agent-participation/manifest.json
WATTETHERIA_MCP_TOKEN_AUTH=false
# Optional remote MCP secret URL; disabled when the bind is unset.
# WATTETHERIA_MCP_PUBLIC_BIND=0.0.0.0:7778
# WATTETHERIA_MCP_PUBLIC_BASE_URL=https://node.example

# Wattetheria runtime
WATTETHERIA_AGENT_EVENT_MODE=api_runtime
# With WATTETHERIA_AGENT_EVENT_MODE=mcp_events, every agent event is pushed to this URL.
# WATTETHERIA_EVENT_WEBHOOK_URL=
# WATTETHERIA_EVENT_WEBHOOK_HEADERS=Authorization: Bearer <receiver key>
# WATTETHERIA_EVENT_WEBHOOK_SECRET=
# WATTETHERIA_EVENT_WEBHOOK_TEXT=false
WATTETHERIA_BRAIN_PROVIDER_KIND=rules
WATTETHERIA_BRAIN_BASE_URL=
WATTETHERIA_BRAIN_MODEL=
WATTETHERIA_BRAIN_API_KEY_ENV=
WATTETHERIA_BRAIN_API_KEY=
WATTETHERIA_BRAIN_RUNTIME_ADAPTER=
WATTETHERIA_BRAIN_SESSION_HEADER_NAME=
WATTETHERIA_BRAIN_SESSION_MODE=stable_per_scope
WATTETHERIA_SERVICENET_BASE_URL=
WATTETHERIA_GATEWAY_URLS=
WATTETHERIA_AUTONOMY_ENABLED=false
WATTETHERIA_AUTONOMY_INTERVAL_SEC=30

# Wattswarm database
WATTSWARM_STORAGE_BACKEND=sqlite

# Wattswarm runtime and network
WATTSWARM_P2P_ENABLED=true
WATTSWARM_P2P_MDNS=true
WATTSWARM_P2P_PORT=4001
WATTSWARM_DISCOVERY_AGENT_CARD_ENABLED=true
WATTSWARM_IROH_RELAY_URLS=https://relay.wattetheria.com
WATTSWARM_IROH_BIND_ADDR=0.0.0.0:4002
WATTSWARM_IROH_PUBLISH_DIRECT_ADDRS=false
WATTSWARM_IROH_DATA_PLANE_START_TIMEOUT_MS=120000
WATTSWARM_PUBLIC_BOOTSTRAP_URLS=
WATTSWARM_PUBLIC_BOOTSTRAP_CONTACTS=
WATTSWARM_PUBLIC_GATEWAY_URLS=
WATTSWARM_PUBLIC_DISCOVERY_URLS=
WATTSWARM_NETWORK_JOIN_MANIFEST_URLS=
WATTSWARM_WORKER_CONCURRENCY=16
WATTSWARM_WORKER_POLL_MS=250
WATTSWARM_WORKER_LEASE_MS=30000
WATTSWARM_UDP_ANNOUNCE_ENABLED=false
WATTSWARM_UDP_ANNOUNCE_MODE=multicast
WATTSWARM_UDP_ANNOUNCE_ADDR=239.255.42.99
WATTSWARM_UDP_ANNOUNCE_PORT=37931
